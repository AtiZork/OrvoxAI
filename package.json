{
  "name": "orvox-revamp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cpanel": "CPANEL_BUILD=1 NODE_ENV=production next build --webpack && node scripts/cpanel-postbuild.js",
    "build:cpanel:same-domain": "NEXT_PUBLIC_API_URL= CPANEL_BUILD=1 NODE_ENV=production next build --webpack && node scripts/cpanel-postbuild.js",
    "deploy:backend": "npm install --prefix backend && npm run deploy:cpanel --prefix backend",
    "deploy:cpanel:server": "npm run deploy:backend",
    "deploy:cpanel": "npm run deploy:cpanel:server",
    "deploy:cpanel:full": "npm install && npm run build:cpanel:same-domain && npm run deploy:backend",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@prisma/client": "^7.2.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.2",
    "@types/animejs": "^3.1.13",
    "@types/bcryptjs": "^2.4.6",
    "@types/multer": "^2.0.0",
    "animejs": "^3.2.2",
    "bcryptjs": "^3.0.3",
    "gsap": "^3.14.1",
    "lenis": "^1.3.15",
    "lucide-react": "^0.556.0",
    "maath": "^0.10.8",
    "multer": "^2.0.2",
    "next": "^16.1.1",
    "next-auth": "^4.24.13",
    "prisma": "^7.2.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "^0.181.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.0.7",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
