# Copy to backend/.env on the server (cPanel → Setup Node.js App → Environment variables)

NODE_ENV=production
PORT=3001
HOST=0.0.0.0

# SQLite file — use an absolute path outside public_html (writable by Node)
DATABASE_URL=file:/home/YOUR_CPANEL_USER/orvox/data/orvox.db

# Comma-separated site URLs (must match browser origin exactly)
FRONTEND_URL=https://yourdomain.com,https://www.yourdomain.com

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Optional: custom folders (defaults to backend/uploads and backend/data)
UPLOAD_ROOT=/home/YOUR_CPANEL_USER/orvox/uploads
